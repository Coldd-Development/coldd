# Storage / CDN settings. Copy to .env for local scripts; never commit real values.
# The site itself is static, so the SERVER-SIDE values below are set in two places:
#   - Supabase secrets (edge functions):  supabase secrets set KEY=value
#   - ~/cdn-config.php on the Ultimate Hosting account (see cdn/README.md)

# --- Supabase secrets (edge functions: admin-get-upload-url, get-avatar-upload-url)
STORAGE_DRIVER=cdn                              # set to "supabase" to instantly roll back to Supabase Storage
CDN_PUBLIC_URL=https://cdn.coldd.dev            # base for public image URLs
CDN_UPLOAD_URL=https://cdn.coldd.dev/upload.php # signed-upload endpoint on the hosting account
CDN_UPLOAD_SECRET=                              # 40+ random chars; must match 'secret' in cdn-config.php (openssl rand -hex 32)
CDN_DOWNLOAD_URL=                               # optional, defaults to CDN_PUBLIC_URL/download.php

# --- Migration script only (scripts/migrate-media-to-cdn.mjs) - keep on your machine
SUPABASE_URL=https://ekinmytmudjwfaqaqswp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Backup (~/.cdn-backup.env on the hosting account, used by cdn/backup.sh)
BOX_USER=
BOX_HOST=
BOX_DIR=coldd-cdn
SRC_PUBLIC=/home/HESTIA_USER/web/cdn.coldd.dev/public_html
SRC_PRIVATE=/home/HESTIA_USER/web/<domain>/private/files
SSH_KEY=~/.ssh/storagebox_ed25519
